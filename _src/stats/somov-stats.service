[Unit]
Description=somov.org owner statistics page (https://dl3.somov.org/stats/)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/somov-counter.env
ExecStart=/usr/bin/python3 /opt/somov-stats/stats.py
DynamicUser=yes
StateDirectory=somov-stats
SupplementaryGroups=adm
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
