[Unit]
Description=somov.org download click counter
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/somov-counter/server.py
EnvironmentFile=/etc/somov-counter.env
DynamicUser=yes
StateDirectory=somov-counter
# Who was already counted today survives restarts and reboots (the file exists only while stopped)
Environment=SEEN_PATH=/var/lib/somov-counter/seen.json
# "Today" / week / month on the site start at midnight in Vietnam (UTC+7), where the owner lives
Environment=TZ=Asia/Ho_Chi_Minh
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target
