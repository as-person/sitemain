[Unit]
Description=somov.org site chat (messages relayed to Telegram)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/somov-chat.env
ExecStart=/usr/bin/python3 /opt/somov-chat/server.py
DynamicUser=yes
StateDirectory=somov-chat
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
